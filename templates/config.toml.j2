# {{ ansible_managed }} - DO NOT EDIT MANUALLY
#
# Rendered by role_containerd. The schema version follows the installed
# runtime: containerd 2.x uses version 3 and the split CRI plugin IDs,
# containerd 1.x uses version 2 and the legacy CRI plugin ID.
version = {{ containerd_config_version }}
root = "/var/lib/containerd"
state = "/run/containerd"
oom_score = 0
disabled_plugins = {{ containerd_config_disabled_plugins | default([]) | to_json }}

[grpc]
  address = "{{ containerd_crictl_runtime_endpoint }}"

[plugins]
{% if containerd_config_version | int >= 3 %}

  [plugins."io.containerd.cri.v1.images"]
    snapshotter = "overlayfs"
    discard_unpacked_layers = false
    max_concurrent_downloads = 3
    image_pull_progress_timeout = "5m0s"
    enable_selinux = false
    disable_apparmor = false

    [plugins."io.containerd.cri.v1.images".pinned_images]
      sandbox = "{{ containerd_sandbox_image }}"

    [plugins."io.containerd.cri.v1.images".registry]
{% if containerd_registry_mirrors | length > 0 %}
      config_path = "{{ containerd_registry_config_path }}"
{% else %}
      config_path = ""
{% endif %}

      [plugins."io.containerd.cri.v1.images".registry.mirrors]
{% for registry, entry in containerd_registry_mirrors.items() %}
        [plugins."io.containerd.cri.v1.images".registry.mirrors."{{ registry }}"]
          endpoint = {{ entry.mirrors | default([]) | to_json }}
{% endfor %}

  [plugins."io.containerd.cri.v1.runtime"]
    enable_selinux = false
    disable_apparmor = false
    disable_hugetlb_controller = true
    stream_server_address = "127.0.0.1"
    stream_server_port = "0"

    [plugins."io.containerd.cri.v1.runtime".containerd]
      default_runtime_name = "runc"

      [plugins."io.containerd.cri.v1.runtime".containerd.runtimes]

        [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc]
          runtime_type = "io.containerd.runc.v2"

          [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc.options]
            SystemdCgroup = {{ containerd_config_systemd_cgroup_enabled | default(false) | lower }}

    [plugins."io.containerd.cri.v1.runtime".cni]
      bin_dir = "{{ containerd_cni_bin_dir }}"
      bin_dirs = ["{{ containerd_cni_bin_dir }}"]
      conf_dir = "{{ containerd_cni_conf_dir }}"
      max_conf_num = 1
{% else %}

  [plugins."io.containerd.grpc.v1.cri"]
    sandbox_image = "{{ containerd_sandbox_image }}"
    max_concurrent_downloads = 3
    image_pull_progress_timeout = "5m0s"
    stream_server_address = "127.0.0.1"
    stream_server_port = "0"
    enable_selinux = false
    disable_apparmor = false
    disable_hugetlb_controller = true

    [plugins."io.containerd.grpc.v1.cri".cni]
      bin_dir = "{{ containerd_cni_bin_dir }}"
      conf_dir = "{{ containerd_cni_conf_dir }}"
      max_conf_num = 1

    [plugins."io.containerd.grpc.v1.cri".containerd]
      default_runtime_name = "runc"
      snapshotter = "overlayfs"
      discard_unpacked_layers = false

      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes]

        [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
          runtime_type = "io.containerd.runc.v2"

          [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
            SystemdCgroup = {{ containerd_config_systemd_cgroup_enabled | default(false) | lower }}

    [plugins."io.containerd.grpc.v1.cri".registry]
{% if containerd_registry_mirrors | length > 0 %}
      config_path = "{{ containerd_registry_config_path }}"
{% else %}
      config_path = ""
{% endif %}

      [plugins."io.containerd.grpc.v1.cri".registry.mirrors]
{% for registry, entry in containerd_registry_mirrors.items() %}
        [plugins."io.containerd.grpc.v1.cri".registry.mirrors."{{ registry }}"]
          endpoint = {{ entry.mirrors | default([]) | to_json }}
{% endfor %}
{% endif %}

  [plugins."io.containerd.internal.v1.opt"]
    path = "/opt/containerd"
